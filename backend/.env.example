# Server
# 4000, not 5000: macOS AirPlay Receiver listens on 5000 by default
PORT=4000
NODE_ENV=development

# MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=erp_db

# CORS - frontend origin allowed to call this API
# (Vite dev server defaults to 5173; set this to whatever origin actually
# calls the API cross-origin. In dev the Vite proxy makes it same-origin.)
CLIENT_URL=http://localhost:5173

# Number of reverse proxies in front of this app.
# 0 / unset = none (local dev). 1 = behind nginx or an ALB - required in
# production so req.ip is the real client IP: with 0, the login rate limiter
# lumps every user into one bucket and audit_logs records the proxy address.
TRUST_PROXY=0

# JWT signing secret: at least 32 characters (enforced when NODE_ENV=production).
# Generate one with:  openssl rand -base64 48
JWT_SECRET=replace_with_a_long_random_string
JWT_EXPIRES_IN=1d

# Session cookie is HTTPS-only when NODE_ENV=production. Set false only to try
# a production build over plain http on a non-localhost address.
COOKIE_SECURE=

# Logging: fatal | error | warn | info | debug | silent  (JSON lines; pipe to `npx pino-pretty` locally)
LOG_LEVEL=info

# Rate limits per client IP: requests per minute for the whole API (health
# checks exempt), and FAILED logins per 15 minutes.
API_RATE_LIMIT_MAX=300
LOGIN_RATE_LIMIT_MAX=10

# Comments must be on their own line: systemd's EnvironmentFile and shell
# `source` do not strip a trailing "# ..." from a value.
#
# Secrets can also be read from files: DB_PASSWORD_FILE, JWT_SECRET_FILE,
# AWS_SECRET_ACCESS_KEY_FILE (path to a file holding the value).

# AWS S3 document storage (optional: leave empty to disable uploads)
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=
