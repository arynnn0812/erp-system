# systemd unit for running the API on a VM without Docker.
# Install (see docs/DEPLOYMENT.md, "Without Docker"):
#   sudo cp deploy/erp-api.service /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now erp-api
[Unit]
Description=ERP System API
After=network-online.target mysql.service
Wants=network-online.target

[Service]
Type=simple
User=erp
Group=erp
WorkingDirectory=/opt/erp-system/backend
# Secrets live here, readable by root only (systemd reads it before
# dropping privileges): chmod 600, owned by root.
EnvironmentFile=/etc/erp/api.env
Environment=NODE_ENV=production
ExecStart=/usr/bin/node src/server.js
Restart=on-failure
RestartSec=5
# SIGTERM starts the API's graceful shutdown, which forces exit after 10s.
KillSignal=SIGTERM
TimeoutStopSec=20

# Hardening: the API only needs to read its code and talk to the network.
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true

[Install]
WantedBy=multi-user.target
