# Server
# 4000, not 5000: macOS AirPlay Receiver listens on 5000 by default
PORT=4000
NODE_ENV=development

# MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=erp_db

# CORS - frontend origin allowed to call this API
# (Vite dev server defaults to 5173; set this to whatever origin actually
# calls the API cross-origin. In dev the Vite proxy makes it same-origin.)
CLIENT_URL=http://localhost:5173

# Number of reverse proxies in front of this app.
# 0 / unset = none (local dev). 1 = behind nginx or an ALB - required in
# production so req.ip is the real client IP: with 0, the login rate limiter
# lumps every user into one bucket and audit_logs records the proxy address.
TRUST_PROXY=0

# JWT (used from Phase 2)
JWT_SECRET=replace_with_a_long_random_string
JWT_EXPIRES_IN=1d

# AWS S3 (used in file-upload phase)
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=
