# Serves the built SPA and proxies /api to the Node API.
# ${API_UPSTREAM} is filled in at container start (default api:4000).
# TLS is expected to end in front of this container (a host nginx/Caddy,
# a cloud load balancer); see docs/DEPLOYMENT.md.

server {
    listen 8080;
    server_name _;
    root /usr/share/nginx/html;

    server_tokens off;
    client_max_body_size 6m; # documents are capped at 5 MB by the API

    gzip on;
    gzip_comp_level 5;
    gzip_min_length 1024;
    gzip_types text/css application/javascript application/json image/svg+xml text/plain;

    # Security headers for the app shell. The API sets its own via helmet.
    # style-src needs 'unsafe-inline' for React style props and the chart
    # library; scripts are all same-origin files (no inline script).
    set $csp "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'";

    # Container health check; not logged.
    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    location /api/ {
        proxy_pass http://${API_UPSTREAM};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        # The API runs with TRUST_PROXY=1 and takes the client IP from here
        # (login rate limiting, audit log).
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        # One id per request, echoed by the API and attached to its log lines.
        proxy_set_header X-Request-Id $request_id;
        proxy_read_timeout 60s;
    }

    # Vite puts a content hash in every asset name, so they never change.
    location /assets/ {
        add_header Cache-Control "public, max-age=31536000, immutable";
        add_header X-Content-Type-Options "nosniff" always;
        try_files $uri =404;
    }

    # Everything else is the SPA: unknown paths get index.html and React
    # Router renders the page (or its 404). Never cached, so a deploy is
    # picked up on the next load.
    location / {
        add_header Cache-Control "no-cache";
        add_header Content-Security-Policy $csp always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header X-Frame-Options "DENY" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
        add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;
        try_files $uri /index.html;
    }
}
