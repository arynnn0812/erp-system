# Settings for docker-compose.yml (copy to .env next to it).
# For running the API without Docker, see backend/.env.example instead.

# --- required ---
# Generate each with:  openssl rand -base64 32   (JWT_SECRET: -base64 48)
MYSQL_ROOT_PASSWORD=
DB_PASSWORD=
JWT_SECRET=

# --- database (created on first start) ---
DB_NAME=erp_db
DB_USER=erp

# --- web ---
# The address people use to open the app.
PUBLIC_URL=http://localhost:8080
WEB_PORT=8080
# 127.0.0.1 = only reachable from this machine (put a TLS proxy in front).
# 0.0.0.0   = reachable from the network over plain http.
WEB_BIND=127.0.0.1
# Proxies in front of the API: 1 = the web container's nginx only.
# Use 2 if a host nginx / load balancer sits in front of the web container.
TRUST_PROXY=1
# Session cookies are HTTPS-only in production. Set false ONLY to try the
# stack over plain http on a non-localhost address (e.g. http://192.168.1.20:8080).
COOKIE_SECURE=

# --- optional ---
JWT_EXPIRES_IN=1d
LOG_LEVEL=info
# Document storage (S3). Leave empty to disable uploads. On EC2 prefer an IAM
# role and leave the key pair empty.
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=
